# Backend-only model credentials. Never commit a real .env file.
AGENTFLOW_LLM_PROVIDER=OpenRouter
AGENTFLOW_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENTFLOW_LLM_MODEL=nvidia/nemotron-3.5-lightning:free
AGENTFLOW_LLM_API_KEY=

# Required to save provider API keys in the local database. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key outside source control and maintain a secure backup.
AGENTFLOW_CREDENTIAL_ENCRYPTION_KEY=

# Live execution is deliberately disabled by default.
# Enable only in a trusted local environment. Add authentication before public deployment.
AGENTFLOW_ENABLE_LIVE_EXECUTION=false
